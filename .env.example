# ============================================================
#  Bottle Publisher - configurazione
#  Copia questo file come ".env" e riempi i valori.
# ============================================================

# ---- Google Gemini (GRATIS) --------------------------------
# Ottieni la chiave su: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Catena di modelli in ordine di priorità (separati da virgola): se il primo
# esaurisce le richieste gratuite, l'app passa automaticamente al successivo.
# Prima i più precisi (20 rich./giorno l'uno), in fondo le grandi riserve:
# gemini-3.1-flash-lite (500/giorno) e gemma-4-31b-it (1500/giorno).
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it

# ---- eBay (GRATIS) -----------------------------------------
# Account sviluppatore gratuito su: https://developer.ebay.com
# 1. Crea un "Application Keyset" (Production)
# 2. Vai su "User Tokens" -> scheda "Auth'n'Auth" -> "Sign in to Production"
#    e genera il token utente (valido ~18 mesi)
EBAY_ENV=production
# oppure: sandbox (per fare prove senza pubblicare davvero)

EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_USER_TOKEN=

# Sito eBay: 101 = eBay Italia
EBAY_SITE_ID=101

# Dove si trova l'oggetto (comparirà nell'annuncio)
EBAY_ITEM_LOCATION=Italia
EBAY_POSTAL_CODE=

# Spedizione: costo fisso in EUR e servizio.
# Se il codice servizio non è valido per il tuo account, apri
# http://localhost:3000/api/ebay/shipping-services per la lista dei codici validi.
EBAY_SHIPPING_COST=9.90
EBAY_SHIPPING_SERVICE=IT_ExpressCourier

# Categoria eBay: se vuoto l'app prova a suggerirla in automatico dal titolo.
# Per forzarne una, metti qui l'ID numerico della categoria.
# 126800 = Collezionismo > Pubblicitario > Bevande > Bottiglie (eBay Italia):
# la categoria giusta per bottiglie piene vendute come pezzi da collezione.
EBAY_DEFAULT_CATEGORY_ID=126800

# ---- Pubblicazione automatica ------------------------------
# true  = dopo l'analisi, se l'AI ritiene la bottiglia vendibile,
#         l'annuncio viene pubblicato su eBay SENZA conferma manuale.
# false = l'annuncio resta sempre in bozza e pubblichi tu col pulsante.
AUTO_PUBLISH=true
# Non pubblicare in automatico sotto questo prezzo stimato (euro, 0 = nessuna soglia)
AUTO_PUBLISH_MIN_PRICE=8

# ---- Server ------------------------------------------------
PORT=3000
# Accesso all'app con nome utente e password.
# APP_PASSWORD vuota = nessuna protezione: va bene SOLO in rete locale di casa.
# Se l'app è raggiungibile da internet, IMPOSTALI ENTRAMBI.
APP_USER=
APP_PASSWORD=
